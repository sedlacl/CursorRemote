# === Core ===
CDP_URL=http://127.0.0.1:9222
# Port of the running CursorRemote relay. Used by `npm run dev:gui` vite proxy.
# Defaults to SERVER_PORT, then 3001. Set explicitly when the extension relay
# listens on a different port (for example 3000).
# CURSOR_REMOTE_RELAY_PORT=3001
SERVER_PORT=3001
SERVER_HOST=127.0.0.1
POLL_INTERVAL_MS=500
DEBOUNCE_MS=300
SELECTORS_PATH=./selectors.json
LOG_LEVEL=info

# === Window Titles ===
# Include remote qualifier ([WSL: ...], [SSH: ...]) in window titles.
# Set to false for cleaner Telegram topic names when you don't need to
# distinguish the same project opened locally and remotely.
# WINDOW_TITLE_QUALIFIER=false

# === Web App Security (optional) ===
# Set a password to protect the web UI. Leave empty for no auth.
WEBAPP_PASSWORD=my-secret-password

# Optional Bearer token for agent/CLI access to /debug/* when WEBAPP_PASSWORD is set.
# The visible Diagnostic ID in the web UI is NOT a secret and does not grant access alone.
# DIAGNOSTIC_TOKEN=your-long-random-agent-token

# Optional: force the Diagnostic ID (8 chars, Crockford base32: 0-9 A-Z without I L O U).
# By default the relay reuses the ID stored in <DATA_DIR>/diagnostic-id.json, so it
# stays stable across restarts.
# DIAGNOSTIC_ID=ABCD1234

# === Telegram Transport (optional) ===
TELEGRAM_ENABLED=false
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Telegram implementation: "grammy" (default) or "raw".
# Use "raw" if the Grammy bot hangs during startup on your machine
# (typically macOS with network issues to api.telegram.org).
# The raw transport uses Node's built-in fetch with explicit timeouts.
# TELEGRAM_IMPL=grammy

# Optional: hardcode allowed user IDs (overrides /register token auth)
# If set, only these users can use the bot. If not set, anyone with the
# registration token (shown in server console) can /register themselves.
# TELEGRAM_ALLOWED_USERS=123456789,987654321

# === Extension Integration (optional) ===
# These are set automatically when running as a VS Code extension child process.
# You normally don't need to set them for standalone usage.
# LICENSE_KEY=XXXX-XXXX-XXXX-XXXX-XXXX
# DATA_DIR=./data
# LOG_FORMAT=text
